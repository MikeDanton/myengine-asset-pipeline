@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(blake3 CONFIG)
if(@ASSET_PIPELINE_HAS_ZSTD@)
  # Restore the caller's module path after loading our optional dependency.
  set(_asset_pipeline_module_path "${CMAKE_MODULE_PATH}")
  list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
  find_dependency(ZSTD)
  set(CMAKE_MODULE_PATH "${_asset_pipeline_module_path}")
  unset(_asset_pipeline_module_path)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/asset_pipelineTargets.cmake")
check_required_components(AssetPipeline)
